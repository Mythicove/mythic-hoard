# Hoard 服务监听地址
HOARD_LISTEN_ADDR=:8081
# 单 API 域名（文件直出 URL 基址）
HOARD_BASE_URL=http://localhost:8080
# 上传/审核鉴权 token（留空则开放上传）
HOARD_ADMIN_TOKEN=
# Postgres（与 Mirror 共享；留空则退回进程内内存，仅开发）
HOARD_DATABASE_URL=

# 存储：local / s3
HOARD_STORAGE_DRIVER=local
HOARD_DATA_DIR=data/files
HOARD_S3_ENDPOINT=
HOARD_S3_REGION=auto
HOARD_S3_BUCKET=
HOARD_S3_ACCESS_KEY=
HOARD_S3_SECRET_KEY=

# 搜索：pgtrgm（默认）/ meili
HOARD_SEARCH_DRIVER=pgtrgm
HOARD_MEILI_URL=
HOARD_MEILI_API_KEY=

# 队列：inline（默认）/ asynq
HOARD_QUEUE_DRIVER=inline
HOARD_REDIS_ADDR=

# 限流
HOARD_RATE_LIMIT_RPS=100
HOARD_RATE_LIMIT_BURST=200

# CORS 允许来源（逗号分隔，如前端地址 http://localhost:3101）；留空回退 *（仅开发）
HOARD_CORS_ORIGINS=

# 客户端 IP 解析（限流防伪造，见 shared/clientip）
# 可信代理网段（CIDR/IP，逗号分隔）；留空=默认信任环回+私网+链路本地
# CDN/云 LB 场景必须把边缘网段加进来（如 Cloudflare 的 IP 段）
HOARD_TRUSTED_PROXIES=
# 转发头查询顺序（逗号分隔）；留空=X-Forwarded-For,X-Real-IP,CF-Connecting-IP,True-Client-IP
HOARD_CLIENT_IP_HEADERS=
# 应用直接暴露公网（无任何反代）时设 true，完全忽略转发头
HOARD_CLIENT_IP_TRUST_NONE=false

# 单个 mod 文件大小上限（字节，默认 512MiB；超限返回 413）
HOARD_MAX_FILE_BYTES=536870912
# 开启后新上传项目为 under_review（管理员批准后公开）
HOARD_REQUIRE_REVIEW=false

# OIDC SSO（Mirror 为 IdP）；ISSUER 留空则禁用登录端点
# ISSUER 必须与 mirror 的 MIRROR_BASE_URL（token 的 iss）完全一致，且本服务可访问
HOARD_OIDC_ISSUER=
HOARD_OIDC_CLIENT_ID=
HOARD_OIDC_CLIENT_SECRET=
# 回调地址；留空取 HOARD_BASE_URL + /auth/oidc/callback
HOARD_OIDC_REDIRECT_URL=
# 管理员 subject 白名单（逗号分隔的 Mirror 用户 ID）；命中者登录即映射 role=admin
HOARD_ADMIN_SUBJECTS=
