# Hoard 服务监听地址
HOARD_LISTEN_ADDR=:8081
# 单 API 域名（文件直出 URL 基址）
HOARD_BASE_URL=http://localhost:8080
# 上传/审核鉴权 token（留空则开放上传）
HOARD_ADMIN_TOKEN=
# Postgres（与 Mirror 共享；留空则退回进程内内存，仅开发）
HOARD_DATABASE_URL=

# 存储：local / s3
HOARD_STORAGE_DRIVER=local
HOARD_DATA_DIR=data/files
HOARD_S3_ENDPOINT=
HOARD_S3_REGION=auto
HOARD_S3_BUCKET=
HOARD_S3_ACCESS_KEY=
HOARD_S3_SECRET_KEY=

# 搜索：pgtrgm（默认）/ meili
HOARD_SEARCH_DRIVER=pgtrgm
HOARD_MEILI_URL=
HOARD_MEILI_API_KEY=

# 队列：inline（默认）/ asynq
HOARD_QUEUE_DRIVER=inline
HOARD_REDIS_ADDR=

# 限流
HOARD_RATE_LIMIT_RPS=100
HOARD_RATE_LIMIT_BURST=200
